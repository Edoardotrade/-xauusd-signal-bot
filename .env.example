# Copia questo file in ".env" e compila i valori (NON committare mai il .env)

# Token del tuo bot Telegram (lo ottieni da @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz

# Il tuo chat id (lo ottieni da @userinfobot oppure vedi il README)
TELEGRAM_CHAT_ID=123456789

# Simbolo dati (GC=F = future oro su Yahoo Finance; alternativa: XAUUSD=X)
SYMBOL=GC=F
STRATEGY=trend             # trend, meanrev oppure breakout

# Parametri strategia (puoi lasciarli così)
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
RSI_PERIOD=14
ATR_PERIOD=14
ADX_PERIOD=14
ADX_MIN=20
RISK_REWARD=1.5
DONCHIAN_N=20              # n. barre canale breakout (strategia breakout)
ATR_SL_MULT=1.5
TRAILING_ATR=0             # >0 = trailing stop a Nx ATR (0 = TP fisso)

# Gestione del rischio (conto DEMO)
ACCOUNT_BALANCE=10000
RISK_PERC=0.75            # % del saldo rischiata per trade
MAX_OPEN_POSITIONS=3     # max posizioni aperte insieme (tetto esposizione)
MAX_DAILY_LOSSES=0       # freno: dopo N perdite in un giorno, stop (0 = disattivo)

# Fascia operativa (ora italiana): opera solo tra queste ore
TRADE_START_HOUR=9
TRADE_END_HOUR=20
